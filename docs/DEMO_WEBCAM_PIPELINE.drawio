          </mxGeometry>
        </mxCell>
        <mxCell id="e-stage9-stage2" value="updated bbox" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#d6b656;dashed=1" edge="1" parent="1" source="stage9" target="stage2">
          <mxGeometry relative="1" as="geometry">
