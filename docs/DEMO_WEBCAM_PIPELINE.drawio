        <mxCell id="e-stage6-stage7" value="pred_x / pred_cam" style="endArrow=block;html=1;rounded=0;strokeWidth=2" edge="1" parent="1" source="stage6" target="stage7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-stage7-stage8" value="decode_dict" style="endArrow=block;html=1;rounded=0;strokeWidth=2" edge="1" parent="1" source="stage7" target="stage8">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-stage8-result" value="body params" style="endArrow=block;html=1;rounded=0;strokeWidth=2" edge="1" parent="1" source="stage8" target="result">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-result-render" value="render queue" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#0288d1" edge="1" parent="1" source="result" target="stage10">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-result-consumer" value="ready=True" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#b85450" edge="1" parent="1" source="result" target="output-consumer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-stage8-stage9" value="kp2d_last" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#d6b656" edge="1" parent="1" source="stage8" target="stage9">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
