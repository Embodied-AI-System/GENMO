        <mxCell id="e-stage4-preproc" value="async submit / done" style="endArrow=block;html=1;rounded=0;strokeWidth=1;strokeColor=#9673a6;dashed=1" edge="1" parent="1" source="stage4" target="preproc-async">
          <mxGeometry relative="1" as="geometry"/>
